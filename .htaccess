RewriteEngine On

# Sirve archivos y carpetas reales (assets estáticos) directamente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás pasa por el único punto de entrada.
RewriteRule ^ index.php [L]

# No exponer los scripts SQL ni la base SQLite de desarrollo.
<FilesMatch "\.(sql|sqlite)$">
    Require all denied
</FilesMatch>
